# ---------------------------------------------------------------------------
# Securinets ISET Charguia — environment variables
# Copy to `.env.local` and fill in what you need. Everything is optional for
# local development: without a database the site runs on a file-backed store
# (`.data/`) so you can demo the whole thing in 60 seconds.
# ---------------------------------------------------------------------------

# Members-only challenge range (default true). Set to "false" to open it publicly.
MEMBERS_ONLY="true"

# Registrations with this code are approved instantly. Leave empty to require
# an admin to approve every account from /admin → Players.
MEMBERSHIP_CODE=""

# Public site URL (used for metadata, OG images, certificate links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# Optional OAuth providers (Discord / GitHub) — leave empty to hide the buttons
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Postgres / Supabase (recommended for production).
# Supabase: Project settings → Database → Connection string → "Connection pooling"
# e.g. postgresql://postgres.xxxx:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=""

# Seed admin account (created on first boot when DATABASE_URL or .data store is empty).
# Change the password immediately after the first login in production.
ADMIN_EMAIL="securinetsisetch26@gmail.com"
ADMIN_PASSWORD="ChangeMe!2026"

# Salt used when hashing challenge flags (server-side only, never expose).
# Rotating this invalidates every stored flag hash — update hashes after rotating.
FLAG_PEPPER="securinets-isetch-2026-pepper-change-me"

# Optional: link out to a self-hosted CTFd instance (option B)
NEXT_PUBLIC_CTFD_URL=""
